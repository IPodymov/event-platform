# Copy to .env and adjust. Never commit the real .env.

# Settings module: config.settings.dev | staging | prod | test
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in staging/prod, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# PostgreSQL 16
POSTGRES_DB=tournaments
POSTGRES_USER=tournaments
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tournaments:change-me@localhost:5432/tournaments
DB_CONN_MAX_AGE=60
