# Copy to .env and adjust. Never commit the real .env.

# The settings module is chosen outside this file: manage.py defaults to
# config.settings.dev, pytest uses config.settings.test, servers set
# DJANGO_SETTINGS_MODULE=config.settings.staging|prod in their environment.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in staging/prod, e.g. https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# PostgreSQL 16
POSTGRES_DB=tournaments
POSTGRES_USER=tournaments
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tournaments:change-me@localhost:5432/tournaments
DB_CONN_MAX_AGE=60

# Redis: cache and Celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Host ports published by docker-compose (change if already taken)
WEB_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Email: smtp+tls://user:password@smtp.example.com:587 in staging/prod
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@localhost
# Reverse proxies in front of the app (for client IP in rate limits)
ALLAUTH_TRUSTED_PROXY_COUNT=0

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Discord OAuth app: https://discord.com/developers/applications
# Redirect URI: <site>/accounts/discord/login/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
